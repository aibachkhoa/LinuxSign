{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinuxSign",
  "version": "0.2.0",
  "identifier": "vn.linuxsign.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LinuxSign – Quản lý chữ ký số",
        "width": 1200,
        "height": 800,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "msi", "nsis", "dmg"],
    "category": "Utility",
    "shortDescription": "Ký số và quản lý USB Token chữ ký số",
    "longDescription": "Ký PDF/văn bản bằng USB Token chữ ký số (PKCS#11) và theo dõi hạn chứng thư trên Linux, Windows, macOS.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": { "depends": ["pcscd", "libccid"] },
      "rpm": { "depends": ["pcsc-lite", "pcsc-lite-ccid"] }
    }
  }
}
